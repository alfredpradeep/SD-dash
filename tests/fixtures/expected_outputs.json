{
  "_comment": "Expected output schemas and value ranges for validation. Actual compressed text varies by model weights.",
  "compression_result_schema": {
    "required_fields": [
      "original_text",
      "compressed_text",
      "source_language",
      "target_tokenizer",
      "original_token_count",
      "compressed_token_count",
      "reduction_ratio",
      "semantic_similarity",
      "graph_jaccard",
      "stes_score",
      "compression_applied",
      "rejection_reason",
      "processing_ms",
      "candidates_evaluated"
    ],
    "field_types": {
      "original_text": "str",
      "compressed_text": "str",
      "source_language": "str",
      "target_tokenizer": "str",
      "original_token_count": "int",
      "compressed_token_count": "int",
      "reduction_ratio": "float",
      "semantic_similarity": "float",
      "graph_jaccard": "float",
      "stes_score": "float",
      "compression_applied": "bool",
      "rejection_reason": "Optional[str]",
      "processing_ms": "float",
      "candidates_evaluated": "int"
    }
  },
  "verification_thresholds": {
    "semantic_similarity_min": 0.91,
    "graph_jaccard_min": 0.88,
    "token_reduction_min": 0.15,
    "semantic_similarity_max": 1.0,
    "graph_jaccard_max": 1.0,
    "token_reduction_max": 0.80
  },
  "stes_score_ranges": {
    "english": {"alpha": 1.0, "beta": 0.65, "min_expected": 0.0, "max_expected": 5.0},
    "tamil": {"alpha": 1.3, "beta": 0.9, "min_expected": 0.0, "max_expected": 8.0},
    "hindi": {"alpha": 1.25, "beta": 0.85, "min_expected": 0.0, "max_expected": 7.0},
    "arabic": {"alpha": 1.2, "beta": 0.8, "min_expected": 0.0, "max_expected": 6.5},
    "japanese": {"alpha": 1.15, "beta": 0.75, "min_expected": 0.0, "max_expected": 6.0},
    "chinese": {"alpha": 1.1, "beta": 0.7, "min_expected": 0.0, "max_expected": 5.5}
  },
  "api_response_schema": {
    "compress_endpoint": {
      "status_code": 200,
      "content_type": "application/json",
      "required_fields": [
        "original_text",
        "compressed_text",
        "language",
        "target_tokenizer",
        "original_tokens",
        "compressed_tokens",
        "reduction_ratio",
        "semantic_similarity",
        "graph_jaccard",
        "stes_score",
        "compression_applied",
        "rejection_reason",
        "processing_ms",
        "candidates_evaluated"
      ]
    },
    "health_endpoint": {
      "status_code": 200,
      "required_fields": ["status", "extractor", "searcher", "gate", "cache"]
    },
    "supported_endpoint": {
      "status_code": 200,
      "required_fields": ["languages", "tokenizers"],
      "expected_language_count": 20,
      "expected_tokenizer_count": 10
    }
  },
  "graph_node_types": [
    "entity", "relation", "attribute", "event",
    "negation", "quantifier", "temporal", "modal",
    "sentiment", "condition"
  ],
  "supported_languages": [
    "en", "ta", "hi", "ar", "ja", "zh", "ko", "pt", "es",
    "fr", "de", "id", "ms", "bn", "ur", "te", "ml", "pa", "gu", "mr"
  ],
  "supported_tokenizers": [
    "gpt-4o", "gpt-4o-mini", "gpt-3.5-turbo",
    "claude-3-5-sonnet", "claude-3-haiku", "claude-3-opus",
    "llama-3-8b", "llama-3-70b",
    "mistral-7b", "mistral-8x7b"
  ]
}
