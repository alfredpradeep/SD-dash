# LENS — Linguistic Entropy Attribution Engine
# Copy to .env and customise.

# Runtime
LENS_DEVICE=cpu
LENS_LOG_LEVEL=INFO

# API
LENS_API_HOST=0.0.0.0
LENS_API_PORT=8003

# ClickHouse (optional — runs in dry-run mode without it)
LENS_CLICKHOUSE_HOST=localhost
LENS_CLICKHOUSE_PORT=8123
LENS_CLICKHOUSE_DATABASE=sentinel
LENS_CLICKHOUSE_USER=default
LENS_CLICKHOUSE_PASSWORD=

# Redis (optional — uses in-memory fallback without it)
LENS_REDIS_HOST=localhost
LENS_REDIS_PORT=6379

# Features
LENS_SEMANTIC_ENTROPY_ENABLED=true
LENS_ARBITRAGE_ENABLED=true
LENS_PREDICTION_TRACKING_ENABLED=true

# COMPRESS bridge (connect to ENGINE 1 if running)
LENS_COMPRESS_BRIDGE_ENABLED=false
LENS_COMPRESS_BRIDGE_URL=http://localhost:8001

# Spike prediction tuning
LENS_SPIKE_ALERT_CONFIDENCE_THRESHOLD=0.65
LENS_ROLLING_WINDOW_MINUTES=30
LENS_CUSUM_THRESHOLD=4.0
LENS_CUSUM_DRIFT=0.5
