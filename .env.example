# SHIELD v2 — environment configuration.
#
# Copy to .env (or export these directly). The launcher auto-loads .env
# from this directory if it exists.

# ---- LLM providers (any one enables real calls) ----
# GROQ_API_KEY=gsk_your_groq_key
# GEMINI_API_KEY=your_gemini_key
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ---- Runtime ----
# SHIELD_HOST=0.0.0.0
# SHIELD_PORT=8765
# SHIELD_SIMULATOR_ONLY=false   # set true to force offline simulator mode
# SHIELD_LOG_LEVEL=info
